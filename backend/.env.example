PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roundcode?retryWrites=true&w=majority
# Tune these per deployment size; indexes are created during deploy, not on app startup.
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
# Run `npm run db:indexes` during deployment after schema changes.
REDIS_URL=redis://localhost:6379
# For Upstash, use these instead of REDIS_URL.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Cloudinary (server-side signed profile photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_SECRET=your_super_secret_jwt_key
CLIENT_URL=https://roundcode.roundtabledtu.in

# Nodemailer / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=ROUNDCode <noreply@roundtabledtu.in>
